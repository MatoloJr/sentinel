# Agent LLM (free tier). Only public, aggregated climate data is sent to the provider.
LLM_PROVIDER=gemini            # gemini | groq
GEMINI_API_KEY=                # https://aistudio.google.com/apikey
GROQ_API_KEY=                  # https://console.groq.com/keys
# LLM_MODEL=gemini-2.5-flash   # optional override (groq default: llama-3.3-70b-versatile)
